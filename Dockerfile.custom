# Imagen custom = imagen oficial de Chatwoot + overlay custom/ (solo Ruby).
# No recompila gemas ni assets: nuestros cambios son policies/finders/listeners + application.rb.
# Evita el bug de build de v4.16.2 (bootsnap 1.16 incompatible con Ruby 3.4/prism)
# reutilizando la imagen oficial ya construida y probada.
#
# Build:
#   docker build -f Dockerfile.custom \
#     --build-arg CHATWOOT_VERSION=v4.16.2 \
#     -t ghcr.io/marher0181/chatwoot-custom:4.16.2 .
ARG CHATWOOT_VERSION=v4.16.2
FROM chatwoot/chatwoot:${CHATWOOT_VERSION}

# Overlay: presencia de /app/custom activa ChatwootApp.custom? y carga los módulos Custom::*
COPY custom/ /app/custom/
COPY config/application.rb /app/config/application.rb
